<?xml version="1.0"?>
<!--
 Copyright (C) 2026 the smartcard-portal authors

 SPDX-License-Identifier: GPL-2.0-or-later

 THE PUBLIC (FRONTEND) INTERFACE. This is what an application calls. Applications
 never call the backend: see ../../backends/gtk/data/io.github.sjtrotter.impl.portal.Certificate1.xml
 for the private implementation interface, and docs/IMPL-INTERFACE.md for why it is
 not reachable from an application.

 EXPERIMENTAL INTERFACE, version 1. This is a project-controlled reverse-DNS name.
 It is deliberately NOT in the org.freedesktop.portal.* namespace: that namespace
 belongs to xdg-desktop-portal, and using it would imply an acceptance that does
 not exist. Nothing here is stable and nothing here has been proposed to anyone.
 See docs/PUBLIC-INTERFACE.md, docs/UPSTREAMING.md, docs/ROADMAP.md and
 docs/decisions/.

 The SHAPE, on the other hand, is copied deliberately and closely from
 xdg-desktop-portal: a frontend service owning one well-known bus name, Request
 objects at a caller-computable path, Session objects for long-lived state, and a
 backend selected from *.portal files that implements the impl interface. Copying
 a shape is not claiming a namespace; see docs/decisions/0003 and 0008.
   https://flatpak.github.io/xdg-desktop-portal/docs/
   https://flatpak.github.io/xdg-desktop-portal/docs/doc-org.freedesktop.portal.Request.html
   https://flatpak.github.io/xdg-desktop-portal/docs/doc-org.freedesktop.portal.Session.html

 The name "Certificate" replaced an earlier, hardware-named one (docs/decisions/0009) and may
 still change again before acceptance. The conceptual boundary is a client certificate or
 cryptographic credential; the backing key may be a smart card, a TPM, a software token, a
 phone or a remote HSM. See docs/decisions/0003-own-namespace-before-freedesktop.md and
 docs/decisions/0009-name-it-certificate.md.

 THE CORE CONTRACT IS CREDENTIAL SELECTION PLUS BROKERED OPERATIONS. The system
 keeps the key and performs the operation. OpenPkcs11Endpoint is an EXPERIMENTAL
 compatibility extension for consumers that can only load a PKCS#11 module; it is
 never returned automatically, and what it returns is a broker-controlled
 SYNTHETIC module, not the card forwarded. See
 docs/decisions/0006-failure-modes-of-naive-p11kit-forwarding.md and
 docs/decisions/0007-brokered-operations-are-the-core.md.
-->
<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">

  <!--
      io.github.sjtrotter.portal.Certificate1:
      @short_description: Brokered use of certificate-backed private keys

      Mediates smart cards and other PKCS#11 tokens for applications the way the
      Camera and USB portals mediate devices: the application does not receive
      the device. It receives a grant.

      Exported by the FRONTEND on bus name io.github.sjtrotter.portal.Certificate at
      /io/github/sjtrotter/portal/Certificate.

      Who does what (docs/ARCHITECTURE.md has the full table):

      * The FRONTEND resolves the caller's app id, validates the purpose and the
        options, applies policy and rate limits, consults the permission store
        for remembered certificate SELECTION, owns the Request and Session
        objects and the grant registry, chooses a backend from the installed
        *.portal files, and calls the backend with the app id attached.
      * The BACKEND draws the chooser and the PIN prompt, holds the PKCS#11
        session, and performs the cryptography. It never sees the calling
        application and never trusts anything but the frontend.

      The PIN never crosses this bus, in either direction. The private key never
      leaves the token. The application never holds a PKCS#11 handle unless it
      explicitly asks for the experimental compatibility endpoint.

      What this interface does NOT do:

      - It does not attest purpose. A signature cannot be shown to have come
        from a TLS handshake rather than from arbitrary data. "purpose"
        constrains certificate selection and the words in the consent dialog,
        and nothing else.
      - It does not provide absolute same-UID isolation. It is a strong boundary
        for sandboxed applications and a useful identity-and-consent boundary
        for host applications. See docs/SECURITY.md.
      - It does not enrol, generate keys, change or unblock PINs, or import
        certificates. A service that mediates USE should not be able to perform
        ADMINISTRATION.
      - It does not cache PINs. There is no option asking it to.
  -->
  <interface name="io.github.sjtrotter.portal.Certificate1">

    <!--
        CreateSession:
        @options: vardict
        @session_handle: object path of the io.github.sjtrotter.portal.Session

        Creates the object that will hold a grant. THE SESSION HANDLE IS THE
        GRANT HANDLE: every later call names it, the backend is told about it,
        and closing it releases the grant.

        A session exists before the grant does. It is created empty, becomes a
        grant when AcquireCredential succeeds on it, and is closed by
        ReleaseGrant, by Session.Close(), by expiry, by card removal, or by the
        caller vanishing from the bus.

        Supported keys in @options:

        * session_handle_token s
            Caller-chosen unguessable token forming the last element of the
            session handle, exactly as in
            org.freedesktop.portal.Session.
    -->
    <method name="CreateSession">
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="session_handle" direction="out"/>
    </method>

    <!--
        AcquireCredential:
        @session_handle: the session created by CreateSession
        @parent_window: identifier of the caller's parent window, or ""
        @options: vardict, see below
        @request_handle: object path of the Request

        Asks the user to select a credential and grants its use for a bounded
        purpose and a bounded time. The chooser is drawn by the BACKEND, from
        text the frontend supplies and the caller cannot influence.

        parent_window uses the portal window-identifier convention:
        "wayland:<handle>" from xdg_foreign, "x11:<xid>", or empty. An invalid
        or expired parent MUST NOT fail the request; the backend degrades to an
        unparented, backend-controlled window.
          https://flatpak.github.io/xdg-desktop-portal/docs/window-identifiers.html

        Supported keys in @options:

        * handle_token s
            Caller-chosen unguessable token forming the Request object path, so
            the caller can subscribe BEFORE this call returns.

        * activation_token s
            XDG activation token authorising focus. Distinct from
            parent_window: the parent makes the window transient, the activation
            token permits it to come forward. A background caller without one
            does not steal focus.

        * purpose s
            REQUIRED. One of "client_auth", "signing", "email", "ssh".
            There is deliberately NO "any": a request that will not say what it
            is for cannot be described to the user in the system's own words,
            cannot be given a consent policy, and cannot be filtered. Each
            purpose has its own consent policy: client_auth is normally covered
            by one short grant; signing asks per operation and shows a digest;
            email may justify a session grant; ssh has its own policy and is not
            "signing with extra steps". VALIDATED BY THE FRONTEND: an unknown
            purpose never reaches a backend.

        * certificate_filter a{sv}
            issuers aay        DER-encoded issuer DNs, as a TLS
                               CertificateRequest supplies them
            key_usage as       X.509 key-usage bits that must be present
            eku as             explicit EKU OIDs, where the purpose shorthand
                               is not enough
            key_algorithms as  key types and signature schemes the caller can
                               actually use
            token_label s      restrict to one token
            piv_slot s         "authentication" (9A), "signature" (9C),
                               "key_management" (9D), "card_authentication" (9E)
            All optional, all AND-ed. The frontend validates the SHAPE and
            rejects a malformed filter; the backend applies it, because only the
            backend can see the certificates. Expired and not-yet-valid
            certificates are SHOWN, marked, and selectable: an expired
            certificate is a diagnosis the user needs. Filtering to exactly one
            candidate does not skip the chooser, because the chooser is where
            consent happens.

        * operation_policy a{sv}
            sign b, decrypt b. What the caller is asking to be allowed to do.
            Defaults to { sign: true }. Asking for decrypt changes the consent
            language and is refused by the FRONTEND for purposes that do not
            justify it.

        * requested_lifetime u
            Seconds. A CEILING request, not a floor. Frontend policy may grant
            less and never grants more.

        * interaction_mode s
            "required"  always prompt
            "allowed"   prompt if needed (default)
            "forbidden" never prompt; a request that would need a chooser or a
                        PIN fails with InteractionRequired

        * allow_selection_memory b
            Permits the user to be OFFERED "use this certificate next time".
            Preselection only: it never skips consent, never skips a PIN, and is
            ignored for callers whose identity could not be verified. The
            remembered selection lives in the PERMISSION STORE, is read and
            written by the FRONTEND, and is keyed on the app id, the purpose and
            the filter context. There is no remembered authorisation and no
            remembered PIN.

        * reason s
            UNTRUSTED caller-supplied hint. Displayed subordinate to and visibly
            labelled as application-provided text, never in the trusted identity
            position, never logged.

        * context s
            UNTRUSTED caller-supplied destination context, e.g. the host a
            client certificate is wanted for. Displayed as the REQUESTED
            destination. The frontend sees a D-Bus peer, not a TLS connection,
            and cannot verify it.

        * interface_version u
            The caller's maximum understood interface version.

        * correlation s
            Opaque caller token, returned unchanged.

        Results delivered in Request::Response with response 0:

        * grant_id s                opaque id naming this grant in logs and in
                                    GrantInvalidated. NOT a capability: the
                                    session handle plus the owning connection is
                                    what authorises a call.
        * certificate_der ay        chosen leaf certificate, DER
        * chain_der aay             ordered intermediates, best effort
        * chain_status s            "complete" | "partial" | "leaf_only".
                                    Many tokens hold only the leaf; the backend
                                    may assemble the rest from system stores.
                                    This describes COMPLETENESS, not TRUST.
        * token_display a{sv}       token and reader identity FOR DISPLAY only
        * key_type s                "RSA" | "EC"
        * key_size u                modulus bits or curve size
        * key_curve s               curve name for EC keys
        * supported_mechanisms as   mechanisms this grant will accept, already
                                    intersected with the frontend allow-list and
                                    what the backend reported
        * permitted_operations as   subset of "sign", "decrypt"
        * expires_at t              real expiry; may be sooner than requested
        * may_prompt_later b        whether a later Sign or Decrypt may show a
                                    window. A caller must never be able to claim
                                    it was promised silence.
        * correlation s             returned unchanged
    -->
    <method name="AcquireCredential">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="request_handle" direction="out"/>
    </method>

    <!--
        Sign:
        @session_handle: the grant
        @parent_window: parent for any prompt this operation needs, or ""
        @options: vardict; operation_id, mechanism, parameters, data
        @request_handle: object path of the Request

        Performs one signature with the grant's key.

        THIS RETURNS A REQUEST, NOT A SIGNATURE, because it MAY PROMPT: the
        first private-key use triggers the backend's lazy login, and some
        purposes require per-operation consent. may_prompt_later said so at
        grant time. The Request shape is what lets the caller cancel a prompt it
        no longer wants with Request.Close(), and it is what every other
        possibly-interactive portal method does.

        Supported keys in @options:

        * handle_token s        forms the Request path, as everywhere else
        * operation_id s        caller-chosen id correlating cancellation,
                                result and log line without correlating them by
                                content
        * mechanism s           REQUIRED. A name from the grant's
                                supported_mechanisms.
        * parameters a{sv}      mechanism parameters. RSA-PSS hash, MGF and salt
                                length are VALIDATED against the mechanism and
                                the key by the backend rather than passed
                                through. Nothing the caller supplies - handles,
                                lengths, operation state - is trusted.
        * data ay               REQUIRED. Digest or message, as the mechanism
                                requires. A size limit applies.

        Results with response 0:

        * signature ay
        * operation_id s        returned unchanged

        A signature is NOT an attestation of purpose. Neither the frontend nor
        the backend can prove this input came from a TLS handshake rather than
        from arbitrary data.
    -->
    <method name="Sign">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="request_handle" direction="out"/>
    </method>

    <!--
        Decrypt:

        Optional and NOT in v1. Refused unless the grant's permitted_operations
        includes "decrypt". Consent is per-operation or tightly bounded, because
        decryption exposes confidential data rather than producing an
        authentication artefact. Same options as Sign, with "ciphertext" in
        place of "data"; results carry "plaintext".
    -->
    <method name="Decrypt">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="request_handle" direction="out"/>
    </method>

    <!--
        RenewGrant:

        Extends a grant ONLY while the caller identity and token binding are
        unchanged, and NEVER expands its permitted operations or mechanisms.
        Enforced by the FRONTEND, which owns grant identity, policy and expiry.
        Reauthorisation - a fresh AcquireCredential - is required after long
        inactivity, token removal and reinsertion, a policy change, or a change
        in application identity.
    -->
    <method name="RenewGrant">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="t" name="expires_at" direction="out"/>
    </method>

    <!--
        ReleaseGrant:

        Ends a grant immediately: the frontend closes the session, the backend
        closes its PKCS#11 session, logs out where the token supports it,
        poisons every endpoint and cancels in-flight operations. Only the owning
        connection may release a grant. Releasing an already-dead grant
        succeeds.

        This is the smartcard-shaped spelling of
        io.github.sjtrotter.portal.Session.Close(), which does exactly the same
        thing on the same object and is equally valid. Both exist because the
        grant vocabulary predates the session plumbing; docs/UPSTREAMING.md
        records that a reviewer may reasonably ask for one of them to go.
    -->
    <method name="ReleaseGrant">
      <arg type="o" name="session_handle" direction="in"/>
    </method>

    <!--
        GetCapabilities:

        What this INSTALLATION actually supports - the frontend's policy
        intersected with what the selected backend reported - so callers
        negotiate rather than probe by failing:

          interface_version u, purposes as, operations as, mechanisms as,
          pkcs11_endpoint b, endpoint_version u, selection_memory b,
          protected_authentication_path b, max_grant_lifetime u,
          backend s  (the *.portal file that was selected, for diagnostics)
    -->
    <method name="GetCapabilities">
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="a{sv}" name="capabilities" direction="out"/>
    </method>

    <!--
        OpenPkcs11Endpoint:
        @session_handle: the grant
        @options: vardict, reserved
        @endpoint_fd: Unix socket file descriptor speaking the p11-kit RPC protocol
        @certificate_uri: RFC 7512 URI, valid ONLY on this endpoint
        @private_key_uri: RFC 7512 URI, valid ONLY on this endpoint
        @endpoint_version: wire/behaviour version of this endpoint

        EXPERIMENTAL, milestone 2, OPT-IN. For consumers that cannot use
        brokered operations because their TLS stack wants a PKCS#11 module.
        Never returned automatically; GetCapabilities says whether it exists.

        THE FD IS PRODUCED BY THE BACKEND AND RELAYED BY THE FRONTEND. The
        backend holds the token session, so it is the only side that can serve a
        synthetic module bound to it; the frontend checks the grant, the caller
        and the policy, calls the impl method, and passes the descriptor
        straight through without holding a copy. The precedent for a file
        descriptor crossing the impl boundary is
        org.freedesktop.impl.portal.RemoteDesktop.ConnectToEIS (fd out) and
        org.freedesktop.impl.portal.Secret.RetrieveSecret (fd in).

        What comes back is NOT the card forwarded. Stock p11-kit forwarding
        exposes a TOKEN, forwards the whole PKCS#11 interface including object
        creation and key generation, and does not carry login state across the
        boundary. This endpoint is served by a broker-controlled SYNTHETIC
        module: one synthetic slot, one synthetic token, only the granted leaf
        certificate, its keys and explicitly selected chain certificates,
        synthetic handles mapped to broker-owned ones, read-only sessions only,
        no SO login, a mechanism allow-list with parameter validation, rate
        limits, and refusal of C_InitToken, C_InitPIN, C_SetPIN, C_CreateObject,
        C_CopyObject, C_DestroyObject, C_SetAttributeValue, key generation,
        wrap/unwrap, derivation, RNG seeding and operation-state export. The
        PKCS#11 v3 interface tables are filtered as well as the v2 function
        list.

        A consumer's C_Login is treated as an authorisation-state transition: it
        does not carry a real PIN and none is forwarded. The backend prompts and
        logs into its OWN session on first private-key use.

        The endpoint is a FILE DESCRIPTOR, not a path: a path is discoverable,
        races on the filesystem, and needs a bind mount to cross a sandbox.

        The URIs are meaningful only on this endpoint. A URI without an endpoint
        that resolves it is not a capability and is never returned alone. NO
        pin-value AND NO pin-source EVER APPEARS IN A URI EITHER SIDE EMITS.

        This is experimental because consumers may not be able to LOAD it: a
        PKCS#11 URI cannot name a socket, g_tls_certificate_new_from_pkcs11_uris
        has no module parameter, and a browser's network process may have
        started before the endpoint existed. The likely resolution is the
        opposite shape - ONE permanently registered broker module exposing
        synthetic grant-bound slots, with this call returning a URI that module
        can resolve. docs/SPIKES.md S3 decides; endpoint_version exists so the
        answer can change the wire format.
    -->
    <method name="OpenPkcs11Endpoint">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="h" name="endpoint_fd" direction="out"/>
      <arg type="s" name="certificate_uri" direction="out"/>
      <arg type="s" name="private_key_uri" direction="out"/>
      <arg type="u" name="endpoint_version" direction="out"/>
    </method>

    <!--
        TokenAdded / TokenRemoved:

        @token carries DISPLAY identity only. These exist because a consumer
        must be able to react to removal mid-flow and to offer "insert your
        card" at a sensible moment.

        The backend observes the hardware and tells the frontend; the FRONTEND
        decides who hears about it. A caller that has never held a grant learns
        nothing: enumerating a user's tokens with no UI is itself a disclosure -
        which cards, how many readers, whose issuance.

        There is deliberately no ListTokens in v1, for the same reason. These
        signals are justified by demonstrated need; enumeration on demand is
        not, yet.
    -->
    <signal name="TokenAdded">
      <arg type="a{sv}" name="token"/>
    </signal>
    <signal name="TokenRemoved">
      <arg type="a{sv}" name="token"/>
    </signal>

    <!--
        GrantInvalidated:
        @session_handle: the grant that died
        @reason: "released" | "expired" | "token_removed" | "owner_gone" |
                 "policy" | "service_shutdown" | "backend_gone" | "error"

        Card removal invalidates every session and object, cancels in-flight
        operations, and POISONS the endpoint so it cannot silently rebind to a
        reinserted card. Reinsertion requires explicit reselection even when the
        label and slot number match, because they prove nothing.

        "backend_gone" is new with the frontend/backend split: if the backend
        crashes or is replaced, every grant it was holding a token session for
        is dead, and the frontend says so rather than leaving a caller holding a
        handle to nothing.

        The Session object's own Closed signal fires for the same events and
        carries the same reason in its details vardict.
    -->
    <signal name="GrantInvalidated">
      <arg type="o" name="session_handle"/>
      <arg type="s" name="reason"/>
    </signal>

    <property name="version" type="u" access="read"/>

  </interface>

  <!--
      io.github.sjtrotter.portal.Request:
      @short_description: One interactive transaction

      Copied closely from org.freedesktop.portal.Request. Exported by the
      FRONTEND at
      /io/github/sjtrotter/portal/Certificate/request/<sender>/<handle_token>,
      where <sender> is the caller's unique name with the leading ":" removed
      and "." replaced by "_", so the caller can subscribe before calling and
      never race the response.

      The frontend's Request is a DIFFERENT OBJECT from the backend's: when the
      frontend calls the backend it exports an
      io.github.sjtrotter.impl.portal.Request on the backend's connection and
      forwards Close() to it. The application can never reach the backend's.
  -->
  <interface name="io.github.sjtrotter.portal.Request">

    <!--
        Close:

        Cancels the transaction. There is no separate Cancel method. After
        Close() no success Response follows, per portal convention.
    -->
    <method name="Close"/>

    <!--
        Response:
        @response: 0 success, 1 cancelled by the user or by Close(), 2 other
        @results: per-method, see the method documentation

        At most ONE terminal response is ever emitted. On response 2, @results
        carries "error" (an io.github.sjtrotter.portal.Certificate1.Error.* name)
        and "error_message". Incorrect PIN, blocked PIN, cancelled prompt,
        device error and token removal are always distinguished from one
        another.
    -->
    <signal name="Response">
      <arg type="u" name="response"/>
      <arg type="a{sv}" name="results"/>
    </signal>

  </interface>

  <!--
      io.github.sjtrotter.portal.Session:
      @short_description: One grant

      Copied closely from org.freedesktop.portal.Session. Exported by the
      FRONTEND at
      /io/github/sjtrotter/portal/Certificate/session/<sender>/<session_handle_token>.

      A session here IS a grant: one certificate, one key, one operation set,
      one verified caller, one bounded time. The frontend owns it - its
      identity, its policy, its expiry and its binding to an app id - and the
      backend holds the PKCS#11 session that stands behind it. A client
      vanishing from the bus closes its sessions, as upstream specifies.
  -->
  <interface name="io.github.sjtrotter.portal.Session">

    <!--
        Close:

        Closes the session and releases the grant. Identical in effect to
        Certificate1.ReleaseGrant on the same handle.
    -->
    <method name="Close"/>

    <!--
        Closed:
        @details: reason s, and grant_id s

        Emitted when the grant ends, for any of the reasons listed under
        GrantInvalidated.
    -->
    <signal name="Closed">
      <arg type="a{sv}" name="details"/>
    </signal>

    <property name="version" type="u" access="read"/>

  </interface>

</node>
