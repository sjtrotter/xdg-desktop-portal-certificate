# SPDX-License-Identifier: GPL-2.0-or-later
#
# D-Bus activation for the portal FRONTEND. It is a SESSION service: the cards are
# the user's and nothing here needs root.
#
# This is this project's own incubation bus name, not a stand-in for the shared
# org.freedesktop.portal.Desktop singleton; see docs/decisions/0008-build-to-the-
# upstream-shape.md, "Per-project bus names during incubation". Applications talk
# to THIS name and to no other; the backend has its own name and is not for
# applications.
#
# EXPERIMENTAL. The binary this points at is a design-sketch stub that exits 70.

[D-BUS Service]
Name=io.github.sjtrotter.portal.Certificate
Exec=@libexecdir@/certificate-portal-frontend
