# SPDX-License-Identifier: GPL-2.0-or-later
#
# Backend selection for the smartcard portal frontend, in xdg-desktop-portal's
# portals.conf format:
#   https://flatpak.github.io/xdg-desktop-portal/docs/portals.conf.html
#
# Install as one of, highest priority first:
#
#   $XDG_CONFIG_HOME/smartcard-portal/(DESKTOP-)portals.conf
#   $XDG_CONFIG_DIRS/smartcard-portal/(DESKTOP-)portals.conf
#   ${sysconfdir}/smartcard-portal/(DESKTOP-)portals.conf
#   $XDG_DATA_HOME/smartcard-portal/(DESKTOP-)portals.conf
#   $XDG_DATA_DIRS/smartcard-portal/(DESKTOP-)portals.conf
#   ${datadir}/smartcard-portal/(DESKTOP-)portals.conf
#
# where DESKTOP is a lowercased entry from $XDG_CURRENT_DESKTOP. The value of a
# key is a semicolon-separated list of *.portal basenames tried in order;
# "none" disables the interface and "*" means the first available backend in
# alphabetical order.
#
# This is an EXAMPLE and is deliberately not installed: an installation that
# ships exactly one backend does not need a configuration file, and one that
# ships two should be choosing on purpose.

[preferred]
default=gtk
io.github.sjtrotter.impl.portal.Smartcard1=gtk
