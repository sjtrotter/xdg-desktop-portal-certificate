# SPDX-License-Identifier: GPL-2.0-or-later
#
# The backend description file, in xdg-desktop-portal's *.portal format:
#   https://flatpak.github.io/xdg-desktop-portal/docs/writing-a-new-backend.html
#
# Installed as ${datadir}/certificate-portal/portals/gtk.portal -- our-namespace
# equivalent of ${datadir}/xdg-desktop-portal/portals/gtk.portal. The frontend
# scans that directory, reads DBusName and Interfaces, and picks a backend
# according to portals.conf; see frontend/src/portal-impl.h.
#
# UseIn is the legacy mechanism and upstream deprecates it in favour of
# portals.conf. It is kept here for the same reason upstream keeps it: a system
# with no configuration file at all should still work.

[portal]
DBusName=io.github.sjtrotter.impl.portal.Certificate.gtk
Interfaces=io.github.sjtrotter.impl.portal.Certificate1;
UseIn=gnome
