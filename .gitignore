# Meson / Ninja
/build/
/build-*/
/subprojects/*/
!/subprojects/*.wrap
*.o
*.so
*.a
compile_commands.json
.ninja_deps
.ninja_log

# Editors
*~
*.swp
.vscode/
.idea/
.cache/

# Nothing in this repository should ever contain a PIN, a PKCS#11 URI, a card serial or
# a certificate from a real card. If a file like that appears here, the fix is to delete
# it and rotate the credential, not to ignore it.
