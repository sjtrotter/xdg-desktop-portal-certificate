# SPDX-License-Identifier: GPL-2.0-or-later
#
# D-Bus activation for the per-user credential broker. It is a SESSION service:
# the cards are the user's and nothing here needs root.
#
# EXPERIMENTAL. The binary this points at is a design-sketch stub that exits 70.

[D-BUS Service]
Name=io.github.sjtrotter.Smartcard1
Exec=@libexecdir@/smartcard-portal
