# Certificate1 requires a configured backend and XDG_DESKTOP_PORTAL_ENABLE_EXPERIMENTAL=Certificate1; see docs/UPSTREAMING.md.

[portal]
DBusName=org.freedesktop.impl.portal.desktop.certificate
Interfaces=org.freedesktop.impl.portal.experimental.Certificate1;
# UseIn provides legacy backend selection when portals.conf is absent.
UseIn=gnome
