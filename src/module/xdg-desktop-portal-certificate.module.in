# Credential searches may prompt; enable consumers by executable basename. See docs/decisions/0011-client-side-pkcs11-module.md.

module: @module@

# An unavailable Certificate portal must not prevent other modules from loading.
critical: no

# p11-kit matches executable basenames; user module configuration can override this list.
# Firefox and Thunderbird also require PKCS11_PORTAL_CERTIFICATE_ENUMERATE=1 and show their own picker.
enable-in: xdg-desktop-portal-webauth, WebKitNetworkProcess

# Prefer real tokens when consumers traverse modules by priority.
priority: -10
