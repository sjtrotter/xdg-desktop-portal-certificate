# Suppress only library lifetime allocations; any matching stack frame suppresses a leak, so broad GLib entries hide application leaks.
leak:libgtk-4
leak:libgdk
leak:libgnutls
leak:libp11-kit
leak:libpango
leak:libfontconfig
leak:libEGL
leak:libGL
leak:dconf
leak:g_type_register_static
leak:g_type_add_interface_static
leak:g_quark_init
leak:g_quark_from_static_string
leak:g_thread_pool_new
leak:g_private_set_alloc0
leak:g_io_module_new
leak:g_dbus_error_register_error_domain
# The fixture may exit with an undispatched decoded D-Bus message; suppress only the named decoder frame.
leak:g_dbus_message_new_from_blob
